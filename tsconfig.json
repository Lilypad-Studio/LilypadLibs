{
  // Type checking only (`tsc`): tsdown builds dist/, so the sources are written for a bundler
  "compilerOptions": {
    "target": "es2023",
    "lib": ["es2023"],
    "types": ["node"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "noEmit": true,
    // The config files import edge.config.ts as Node.js runs them, with its extension
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "declaration": true,
    "isolatedDeclarations": true,
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src", "scripts", "*.config.ts", "vitest.edge-setup.ts"]
}
