  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "author": {
    "name": "Lilypad Studio"
  },
  "contributors": [
    "Lorenzo Pierro"
  ],
  "scripts": {
    "build": "tsup --dts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --fix",
    "test": "vitest --project unit --project edge",
    "test:integration": "vitest run --project integration",
    "prepare": "husky"
  },
  "peerDependencies": {
    "postgres": "^3.4.7"
  },
  "peerDependenciesMeta": {
    "postgres": {
      "optional": true
    }
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@testcontainers/postgresql": "^12.1.0",
    "@types/node": "^22.20.4",
    "@typescript-eslint/eslint-plugin": "^8.48.1",
    "@typescript-eslint/parser": "^8.48.1",
    "eslint": "^9",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-prettier": "^5.2.1",
    "husky": "^9.1.7",
    "postgres": "^3.4.7",
    "prettier": "^3.4.2",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.15"
  }
