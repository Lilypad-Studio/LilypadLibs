{
  "name": "@lilypad/libs",
  "version": "0.5.0",
  "main": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./cache": {
      "types": "./dist/cache.d.mts",
      "default": "./dist/cache.mjs"
    },
    "./db": {
      "types": "./dist/db.d.mts",
      "default": "./dist/db.mjs"
    },
    "./flow": {
      "types": "./dist/flow.d.mts",
      "default": "./dist/flow.mjs"
    },
    "./logger": {
      "types": "./dist/logger.d.mts",
      "default": "./dist/logger.mjs"
    },
    "./platform": {
      "types": "./dist/platform.d.mts",
      "default": "./dist/platform.mjs"
    },
    "./schema": {
      "types": "./dist/schema.d.mts",
      "default": "./dist/schema.mjs"
    },
    "./serializer": {
      "types": "./dist/serializer.d.mts",
      "default": "./dist/serializer.mjs"
    },
    "./singleton": {
      "types": "./dist/singleton.d.mts",
      "default": "./dist/singleton.mjs"
    }
  },
  "bin": {
    "lilypad-doctor": "dist/lilypad-doctor.mjs"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22.12"
  },
  "author": {
    "name": "Lilypad Studio"
  },
  "contributors": [
    "Lorenzo Pierro"
  ],
  "scripts": {
    "build": "tsdown --config-loader unrun",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --fix",
    "test": "vitest --project unit --project edge",
    "test:integration": "vitest run --project integration",
    "prepare": "husky"
  },
  "peerDependencies": {
    "postgres": "^3.4.7"
  },
  "peerDependenciesMeta": {
    "postgres": {
      "optional": true
    }
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@testcontainers/postgresql": "^12.1.0",
    "@types/node": "^22.20.4",
    "@typescript-eslint/eslint-plugin": "^8.48.1",
    "@typescript-eslint/parser": "^8.48.1",
    "eslint": "^9",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-prettier": "^5.2.1",
    "husky": "^9.1.7",
    "postgres": "^3.4.7",
    "prettier": "^3.4.2",
    "tsdown": "^0.23.0",
    "typescript": "^5.9.3",
    "unrun": "^0.3.1",
    "vitest": "^4.0.15"
  }
}
