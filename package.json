      },
      "require": {
        "types": "./dist/serializer.d.ts",
        "default": "./dist/serializer.js"
      }
    },
    "./singleton": {
      "import": {
        "types": "./dist/singleton.d.mts",
        "default": "./dist/singleton.mjs"
      },
      "require": {
        "types": "./dist/singleton.d.ts",
        "default": "./dist/singleton.js"
      }
    }
