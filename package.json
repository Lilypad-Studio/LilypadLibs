{
  "name": "@lilypad/libs",
  "version": "0.4.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "module": "./dist/index.mjs",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./cache": {
      "import": {
        "types": "./dist/cache.d.mts",
        "default": "./dist/cache.mjs"
      },
      "require": {
        "types": "./dist/cache.d.ts",
        "default": "./dist/cache.js"
      }
    },
    "./db": {
      "import": {
        "types": "./dist/db.d.mts",
        "default": "./dist/db.mjs"
      },
      "require": {
        "types": "./dist/db.d.ts",
        "default": "./dist/db.js"
      }
    },
    "./flow": {
      "import": {
        "types": "./dist/flow.d.mts",
        "default": "./dist/flow.mjs"
      },
      "require": {
        "types": "./dist/flow.d.ts",
        "default": "./dist/flow.js"
      }
    },
    "./logger": {
      "import": {
        "types": "./dist/logger.d.mts",
        "default": "./dist/logger.mjs"
      },
      "require": {
        "types": "./dist/logger.d.ts",
        "default": "./dist/logger.js"
      }
    },
    "./platform": {
      "import": {
        "types": "./dist/platform.d.mts",
