{
  "name": "@lilypad-studio/libs",
  "version": "0.7.0",
  "description": "Internal TypeScript utilities of Lilypad Studio: cache, PostgreSQL gateway, logger, flow control, serializer and singletons.",
  "license": "UNLICENSED",
  "author": {
    "name": "Lilypad Studio"
  },
  "contributors": [
    "Lorenzo Pierro"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lilypad-Studio/LilypadLibs.git"
  },
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./cache": "./dist/cache.mjs",
    "./db": "./dist/db.mjs",
    "./flow": "./dist/flow.mjs",
    "./logger": "./dist/logger.mjs",
    "./platform": "./dist/platform.mjs",
    "./schema": "./dist/schema.mjs",
    "./serializer": "./dist/serializer.mjs",
    "./singleton": "./dist/singleton.mjs",
    "./package.json": "./package.json"
  },
  "bin": {
    "lilypad-doctor": "./dist/lilypad-doctor.mjs"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "engines": {
    "node": ">=22.12"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=22.22.1",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": ">=10.9.0",
      "onFail": "error"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.edge.json",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --project unit --project edge",
    "test:watch": "vitest --project unit --project edge",
    "test:integration": "vitest run --project integration",
    "coverage": "vitest run --project unit --coverage",
    "knip": "knip",
    "docs:api": "typedoc",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build && npm run knip",
    "changeset": "changeset",
    "release": "changeset publish",
    "prepack": "npm run build",
    "prepare": "husky"
  },
  "peerDependencies": {
    "postgres": "^3.4.7"
  },
  "peerDependenciesMeta": {
    "postgres": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@edge-runtime/vm": "^5.0.0",
    "@testcontainers/postgresql": "^12.2.0",
    "@types/node": "^22.20.4",
    "@vitest/coverage-v8": "^5.0.2",
    "@vitest/eslint-plugin": "^1.6.27",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "husky": "^9.1.7",
    "knip": "^6.38.0",
    "lint-staged": "^17.6.0",
    "postgres": "^3.4.9",
    "prettier": "^3.9.9",
    "publint": "^0.3.24",
    "tsdown": "^0.23.0",
    "typedoc": "^0.28.20",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "unplugin-unused": "^0.6.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "lint-staged": {
    "*.{ts,mts,cts,js,mjs,cjs}": [
      "eslint --fix --max-warnings 0",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": "prettier --write"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  }
}
